<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_note_plain"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/widget_name"
                android:textColor="#FF2A2A2A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_body"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="top|start"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.95"
                android:text="@string/widget_desc"
                android:textColor="#FF2A2A2A"
                android:textSize="16sp" />

            <ListView
                android:id="@+id/w_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="none"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Sits beside the text in the top-right corner, so it never covers it. -->
        <ImageView
            android:id="@+id/w_open"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top"
            android:layout_marginStart="6dp"
            android:contentDescription="メモを開く"
            android:padding="5dp"
            android:src="@drawable/ic_edit_note"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
